# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# Copy this file to ".env.gemini" (same folder) and paste your key below.
# This file is separate from the main .env on purpose, so you only ever
# need to touch this one file to add/rotate the AI assistant's key.

GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-3.6-flash if left blank).
GEMINI_MODEL=gemini-3.6-flash
